{
	"name": "jungle-nft-marketplace",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"dev:mocks": "vite --host 127.0.0.1 --mode mock",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --host 127.0.0.1",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write src tests docs scripts *.ts *.js *.cjs *.json *.md",
		"format:check": "prettier --check src tests docs scripts *.ts *.js *.cjs *.json *.md"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	},
	"packageManager": "pnpm@11.8.0",
	"dependencies": {
		"@fontsource-variable/roboto-mono": "^5.3.0",
		"@mswjs/socket.io-binding": "^0.2.0",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-router": "^1.170.45",
		"axios": "^1.20.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.60.0",
		"msw": "^2.10.2",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"socket.io-client": "^4.8.4",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"lighthouse": "12.6.1",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "^9.39.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.4"
	}
}
